{
  "description": "oss-first: keep quarantined third-party code from being built, installed or executed",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/quarantine-guard.sh\""
          }
        ]
      }
    ]
  }
}
